{
  "name": "nexo-league-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Gestionnaire de ligues simracing (iRacing) — Nexotech Digital. Aucune affiliation officielle avec iRacing.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "owner:create": "node scripts/create-owner.ts",
    "worker": "node scripts/worker.ts",
    "worker:once": "node scripts/worker.ts --once"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "dependencies": {
    "@iracing-data/api-client-fetch": "^0.0.1-beta.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}

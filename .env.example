# Nexo League Hub — copier en .env (jamais commité). Aucune valeur réelle ici.
DATABASE_URL=postgresql://nexo:nexo_local_only@localhost:5432/nexo_hub
# Base de tests (détruite et recréée par npm run test:db ; son nom doit contenir « test »).
TEST_DATABASE_URL=postgresql://nexo:nexo_local_only@localhost:5432/nexo_test
# URL publique exacte (https en production). Requise pour OAuth Discord/iRacing et les liens Discord.
APP_ORIGIN=http://localhost:3000
# true derrière HTTPS (production). false uniquement en local http.
COOKIE_SECURE=false
# Ligue affichée sur « / » quand plusieurs ligues existent (sinon la seule ligue).
DEFAULT_COMMUNITY=

# Connexion Discord (facultative). Redirect : ${APP_ORIGIN}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# API iRacing (facultative) : client OAuth enregistré chez iRacing (audience data-server, scope iracing.auth).
# Redirect : ${APP_ORIGIN}/api/auth/iracing/callback
IRACING_CLIENT_ID=
# Uniquement si iRacing a délivré un secret (valeur brute, le masquage est fait côté serveur).
IRACING_CLIENT_SECRET=
# 64 caractères hexadécimaux aléatoires (openssl rand -hex 32). À conserver entre déploiements.
IRACING_TOKEN_KEY=
